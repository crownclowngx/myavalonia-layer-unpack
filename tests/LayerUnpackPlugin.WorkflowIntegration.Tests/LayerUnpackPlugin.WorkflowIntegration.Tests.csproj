<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <OutputType>Exe</OutputType>
    <!-- 工作流的外部项目不在本解决方案中，也必须使用本次测试的构建配置。 -->
    <ShouldUnsetParentConfigurationAndPlatform>false</ShouldUnsetParentConfigurationAndPlatform>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="MyAvaloniaManagement.PluginSdk" />
    <PackageReference Include="MyAvaloniaManagement.PluginSdk.UI" />
    <PackageReference Include="MyAvaloniaManagement.PluginSdk.Workflow" />
    <PackageReference Include="MyAvaloniaManagement.Icons" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="SharpCompress" />
    <PackageReference Include="SharpZipLib" />
    <PackageReference Include="Avalonia.Headless.XUnit" />
    <PackageReference Include="Avalonia.Skia" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <!-- 只要求构建真实插件，测试编译器不能引用插件的私有 CLR 类型。三个入口在运行时分别加载。 -->
    <ProjectReference Include="../../src/LayerUnpackPlugin.Plugin/LayerUnpackPlugin.Plugin.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="../../../myavalonia-fractal-art/src/FractalArtPlugin.Plugin/FractalArtPlugin.Plugin.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="../../../myavalonia-workflow-studio/src/WorkflowStudio.Plugin/WorkflowStudio.Plugin.csproj" ReferenceOutputAssembly="false" />
    <Compile Include="../LayerUnpackPlugin.Tests/TestApp.cs" Link="TestApp.cs" />
    <Compile Include="../LayerUnpackPlugin.Headless.Tests/TestWorkspace.cs" Link="TestWorkspace.cs" />
    <None Include="../../examples/workflow/fractal-archive.workflow.json" Link="Fixtures/fractal-archive.workflow.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../examples/workflow/sample.fractal-workflow.json" Link="Fixtures/sample.fractal-workflow.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
