<UserControl x:Class="LayerUnpackPlugin.Features.Unpack.UnpackView"
 xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:vm="using:LayerUnpackPlugin.Features.Unpack" x:DataType="vm:UnpackDocument" DragDrop.AllowDrop="True">
 <Grid Margin="20" RowDefinitions="Auto,Auto,*,Auto" RowSpacing="14">
  <Grid ColumnDefinitions="*,Auto">
   <StackPanel Spacing="3">
    <TextBlock Text="层解 · Layer Unpack" FontSize="25" FontWeight="SemiBold" />
    <TextBlock Text="批量解压 · 按层展开 · 本批次密码共享" Opacity="0.65" />
   </StackPanel>
   <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
    <Button Content="开始解压" Command="{Binding StartCommand}" />
    <Button Content="取消" Command="{Binding CancelCommand}" />
   </StackPanel>
  </Grid>
  <Border Grid.Row="1" BorderBrush="#44888888" BorderThickness="1" CornerRadius="8" Padding="14">
   <Grid ColumnDefinitions="*,195" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="16" RowSpacing="12">
    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8" IsEnabled="{Binding CanEdit}">
     <TextBlock Text="输出目录" VerticalAlignment="Center" />
     <TextBox Grid.Column="1" Text="{Binding OutputDirectory}" PlaceholderText="选择输出目录" />
     <Button Grid.Column="2" Content="选择…" Click="PickOutput" />
    </Grid>
    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" IsEnabled="{Binding CanEdit}">
     <TextBlock Text="深度" VerticalAlignment="Center" />
     <NumericUpDown Width="130" Minimum="1" Maximum="16" Increment="1" FormatString="0" Value="{Binding MaxDepth}" />
    </StackPanel>
    <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="10" IsEnabled="{Binding CanEdit}">
     <TextBlock Text="旧 ZIP 文件名编码" VerticalAlignment="Center" />
     <ComboBox ItemsSource="{x:Static vm:UnpackDocument.NameEncodings}" SelectedItem="{Binding SelectedNameEncoding}" MinWidth="180" />
     <TextBlock Text="仅影响未标记 Unicode 的名称" Opacity="0.65" VerticalAlignment="Center" />
    </StackPanel>
    <Expander Grid.Row="2" Grid.ColumnSpan="2" Header="候选密码 · 一行一个，仅保留在当前批次" IsEnabled="{Binding CanEdit}">
     <StackPanel Spacing="6">
      <TextBox Text="{Binding PasswordText}" AcceptsReturn="True" MinHeight="72" MaxHeight="130"
       PlaceholderText="最多 64 个候选；保留大小写和首尾空格。重试前可在这里补充密码。" />
      <TextBlock Text="此区域按明文编辑候选；开始后清空输入框，密码池随当前批次释放。" FontSize="12" Opacity="0.65" TextWrapping="Wrap" />
     </StackPanel>
    </Expander>
   </Grid>
  </Border>
  <Grid Grid.Row="2" ColumnDefinitions="240,*,260" ColumnSpacing="14">
   <Grid RowDefinitions="Auto,*,Auto" RowSpacing="8">
    <TextBlock Text="输入压缩包" FontWeight="SemiBold" />
    <ListBox Grid.Row="1" ItemsSource="{Binding Inputs}" IsEnabled="{Binding CanEdit}">
     <ListBox.ItemTemplate><DataTemplate x:DataType="vm:InputItem">
      <CheckBox IsChecked="{Binding IsSelected}" Content="{Binding Name}" ToolTip.Tip="{Binding Path}" />
     </DataTemplate></ListBox.ItemTemplate>
    </ListBox>
    <WrapPanel Grid.Row="2" IsEnabled="{Binding CanEdit}">
     <Button Content="添加压缩包" Click="PickFiles" Margin="0,0,6,6" />
     <Button Content="添加文件夹" Click="PickFolder" Margin="0,0,6,6" />
     <Button Content="移除所选" Command="{Binding RemoveSelectedCommand}" Margin="0,0,6,0" />
     <Button Content="清空批次" Command="{Binding ClearCommand}" />
    </WrapPanel>
   </Grid>
   <Grid Grid.Column="1" RowDefinitions="Auto,*" RowSpacing="8">
    <TextBlock Text="处理结果 · 可将文件拖入此页面" FontWeight="SemiBold" />
    <TreeView Grid.Row="1" ItemsSource="{Binding Roots}" SelectedItem="{Binding SelectedNode}">
     <TreeView.Styles><Style Selector="TreeViewItem"><Setter Property="IsExpanded" Value="True" /></Style></TreeView.Styles>
     <TreeView.ItemTemplate><TreeDataTemplate x:DataType="vm:ArchiveNodeViewModel" ItemsSource="{Binding Children}">
      <StackPanel Orientation="Horizontal" Spacing="10">
       <TextBlock Text="{Binding Name}" /><TextBlock Text="{Binding Status}" Opacity="0.65" />
      </StackPanel>
     </TreeDataTemplate></TreeView.ItemTemplate>
    </TreeView>
   </Grid>
   <Border Grid.Column="2" BorderBrush="#44888888" BorderThickness="1" CornerRadius="8" Padding="12">
    <ScrollViewer><StackPanel Spacing="12">
     <TextBlock Text="当前项详情" FontWeight="SemiBold" />
     <TextBlock Text="{Binding SelectedNode.Source}" TextWrapping="Wrap" />
     <TextBlock Text="{Binding SelectedNode.Details}" TextWrapping="Wrap" />
     <TextBlock Text="{Binding SelectedNode.OutputPath}" TextWrapping="Wrap" Opacity="0.7" />
     <Button Content="打开输出目录" Click="OpenOutput" IsEnabled="{Binding SelectedNode.HasOutput}" />
     <Button Content="重试所选失败项" Command="{Binding RetryCommand}" />
    </StackPanel></ScrollViewer>
   </Border>
  </Grid>
  <StackPanel Grid.Row="3" Spacing="6">
   <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsBusy}" Height="3" />
   <TextBlock Text="{Binding Summary}" FontWeight="SemiBold" TextWrapping="Wrap" />
   <TextBlock Text="{Binding Message}" Opacity="0.75" TextWrapping="Wrap" MaxHeight="100" />
  </StackPanel>
 </Grid>
</UserControl>
